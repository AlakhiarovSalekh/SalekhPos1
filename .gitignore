# =====================================================
# SalekhPos .gitignore
# Catches artefacts across .NET, Node/TS, MAUI, Docker,
# IDE/OS noise. Keep this file the single source of truth.
# =====================================================

# ---------- OS ----------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# ---------- Editors / IDEs ----------
# Visual Studio / Rider / VSCode
.vs/
.vscode/
.idea/
*.user
*.userprefs
*.suo
*.swp
*.swo
*.swn
*.sln.docstates
*.userosscache
*.sln.ide
*.njsproj
*.njsproj.user

# VSCode (allow specific workspace files via .vscodeignore elsewhere)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Cursor / Copilot leftovers
.cursor/
.copilot/
.aider*

# ---------- .NET / ASP.NET Core / EF Core ----------
bin/
obj/
out/
[Oo]bj/
[Bb]in/
*.user
*.suo
*.userprefs
*.pidb
*.userprefs
*.nuget.props
*.nuget.targets
.vs/
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
coverage/
*.coverage
*.coveragexml
*.dll
*.exe
*.pdb
*.cache
*.dylib
*.so
*.dll.config
*.pdb.config

# EF Core
*.mdf
*.ldf
*.ndf
*.ndf
# Migration artefacts
**/Migrations/*.cs.bak

# Blazor / MAUI
**/Resources/Raw/AboutAssets.txt
**/Resources/Raw/*.bin

# MAUI
*.aar
*.jar
*.keystore
!debug.keystore
*.jks
*.keystore
*.p12
*.pfx
*.cer
Bundle/
publish/
*.appx
*.appxbundle
*.appxupload
*.ipa
*.dSYM.zip
*.dSYM
android/keystores/
ios/Build/

# ---------- Node / TypeScript / Vite / React ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
.npm/
.yarn-integrity
*.tgz
.parcel-cache
.next/
.nuxt/
.svelte-kit/
dist/
build/
out/
coverage/
.vite/
*.local
.env
.env.*
!.env.example
!.env.development.example
!.env.production.example
.DS_Store
Thumbs.db
.idea/
.vscode/
yarn-debug.log*
yarn-error.log*
.npm-debug.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_
.uws_cache
.idea/inspectionProfiles/
.idea/libraries/
