.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries
.idea/shelf
storybook-static/
.webpack/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------- Docker ----------
# Ignore all Dockerfile variants in subfolders; keep top-level compose files
# (handled per-project below — top-level docker-compose files are tracked)
**/.docker/
docker-data/
postgres-data/
redis-data/
volumes/
data/

# ---------- Logs / Runtime / Secrets ----------
logs/
*.log
*.log.*
*.pid
*.seed
*.pid.lock
.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets — never commit
secrets/
*.pem
*.key
*.pfx
*.p12
.env
.env.*
!.env.example
appsettings.*.local.json
appsettings.Development.json
appsettings.Development.local.json
!appsettings.json
!appsettings.Development.json
!appsettings.Production.json
!appsettings.Staging.json
webhook-secrets.*
jwt-*
*.secret

# Test outputs
TestResults/
artifacts/
coverage/
*.trx
*.coverage
*.coveragexml

# ---------- Backup / Temporary ----------
*.tmp
*.bak
*.swp
*~
*.orig
*.rej
~$*
