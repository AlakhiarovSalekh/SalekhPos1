root = true

# =====================================================
# SalekhPos .editorconfig
# One shared formatting style across all editors.
# =====================================================

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{ts,tsx,js,jsx,json,yml,yaml,css,scss,html,md}]
indent_size = 2

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
