# syntax=docker/dockerfile:1.7
# SalekhPos — worker (.NET background service).

ARG DOTNET_VERSION=8.0
ARG BUILD_CONFIGURATION=Release

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-alpine AS build
ARG BUILD_CONFIGURATION
WORKDIR /src

COPY backend/global.json backend/
COPY backend/Directory.Build.props backend/
COPY backend/Directory.Packages.props backend/
COPY backend/stylecop.json backend/

COPY backend/src/SalekhPos.Domain/SalekhPos.Domain.csproj backend/src/SalekhPos.Domain/
COPY backend/src/SalekhPos.Application/SalekhPos.Application.csproj backend/src/SalekhPos.Application/
COPY backend/src/SalekhPos.Infrastructure/SalekhPos.Infrastructure.csproj backend/src/SalekhPos.Infrastructure/
COPY backend/src/SalekhPos.Api/SalekhPos.Api.csproj backend/src/SalekhPos.Api/
COPY backend/src/SalekhPos.Worker/SalekhPos.Worker.csproj backend/src/SalekhPos.Worker/

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore backend/SalekhPos.Worker/SalekhPos.Worker.csproj

COPY backend/ backend/

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish backend/src/SalekhPos.Worker/SalekhPos.Worker.csproj \
        -c ${BUILD_CONFIGURATION} \
        -o /app/publish \
        --no-restore \
        /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:${DOTNET_VERSION}-alpine AS runtime
WORKDIR /app

RUN addgroup -S app && adduser -S app -G app
USER app

COPY --from=build --chown=app:app /app/publish ./

ENV DOTNET_ENVIRONMENT=Production
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

ENTRYPOINT ["dotnet", "SalekhPos.Worker.dll"]
