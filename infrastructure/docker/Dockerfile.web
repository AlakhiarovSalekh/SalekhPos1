# syntax=docker/dockerfile:1.7
# SalekhPos — web (React + Vite, served by nginx).
# Multi-stage, non-root, minimal base, no secrets in image.

FROM node:20-alpine AS build
WORKDIR /app

COPY web/salekhpos-web/package.json web/salekhpos-web/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci || npm install

COPY web/salekhpos-web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html

# SPA fallback: unknown paths return index.html so the client router works.
COPY infrastructure/docker/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://localhost:80/ || exit 1
