# SalekhPos — example environment file.
# Copy to .env and adjust. Never commit a real .env.

# ---- Common ----
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
LOG_LEVEL=Information

# ---- Database ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=salekhpos
POSTGRES_USER=salekhpos
POSTGRES_PASSWORD=change-me
DATABASE_URL=Host=postgres;Port=5432;Database=salekhpos;Username=salekhpos;Password=change-me

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth ----
# Generate a 32+ byte secret for HS256 JWT signing. NEVER use the example value in any non-dev environment.
JWT_SIGNING_KEY=dev-only-secret-do-not-use-in-prod-please-rotate
JWT_ISSUER=salekhpos.local
JWT_AUDIENCE=salekhpos.api
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# ---- CORS / Hosts ----
WEB_ORIGIN=http://localhost:5173
DESKTOP_API_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# ---- Integrations (placeholders only; configure per environment) ----
PAYMENT_PROVIDER=Mock
FISCAL_PROVIDER=Mock
EMAIL_PROVIDER=Mock
SMS_PROVIDER=Mock
PUSH_PROVIDER=Mock
OBJECT_STORAGE_PROVIDER=Local

# ---- Workers / SignalR ----
SIGNALR_REDIS_BACKPLANE=false
OUTBOX_POLL_INTERVAL_SECONDS=5
