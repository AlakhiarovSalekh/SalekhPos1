<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SalekhPos.Api</RootNamespace>
    <AssemblyName>SalekhPos.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>salekhpos-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalekhPos.Application\SalekhPos.Application.csproj" />
    <ProjectReference Include="..\SalekhPos.Infrastructure\SalekhPos.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Foundation-only API dependencies. Authentication (JwtBearer),
    SignalR, FluentValidation, Mapster DI, ProblemDetails, and Serilog
    are needed for the foundation health endpoints to compile.
    OpenTelemetry, Application Insights, Polly, etc. are added in their
    respective phases.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Hellang.Middleware.ProblemDetails" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Mapster.DependencyInjection" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

</Project>
