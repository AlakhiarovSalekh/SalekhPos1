<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SalekhPos.Infrastructure</RootNamespace>
    <AssemblyName>SalekhPos.Infrastructure</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalekhPos.Domain\SalekhPos.Domain.csproj" />
    <ProjectReference Include="..\SalekhPos.Application\SalekhPos.Application.csproj" />
  </ItemGroup>

  <!--
    Foundation-only dependencies. EF Core / Npgsql are wired here so the
    scaffolding compiles and the next phase can introduce the DbContext.
    Authentication / Argon2 / OTP / payment / fiscal packages are added
    in their respective phases (Phase 2+, Phase 16+).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SalekhPos.Api" />
    <InternalsVisibleTo Include="SalekhPos.Worker" />
    <InternalsVisibleTo Include="SalekhPos.Tests" />
  </ItemGroup>

</Project>
